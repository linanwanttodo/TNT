# Test artifacts written with a stray "file:" prefix
file:/
core/file:/

# Local agent and analysis tool state. These trees reach hundreds of megabytes
# and are never part of a build, so they must not be committable.
.mimosa/
.v2c/
.zion-mcp/
.vitest/

# esbuild's analysis output, written next to the CLI package rather than into
# dist so that it never ships with a release.
packages/cli/build-meta.json

# Review-round notes about this repository. They are read by whoever is working
# the open items, not built or shipped, and the format gate cannot tell a note
# from a product document - so they stay on disk and out of git.
analysis/

# Implementation plans for this repository, like `analysis/`: read by whoever is
# working the items, never built or shipped, and a private work-list does not
# belong in a documentation tree that the site build walks.
docs/superpowers/

# The TNT workspace folder. The directory skeleton travels with the repo as
# tracked `.keep` placeholders so a fresh clone has every group the engine
# reads (rules, checks, agents, prompts); everything else in it is per-machine
# and stays local - the rule and check documents themselves, the memory file
# TNT accumulates, and the agent instructions each maintainer writes.
.tnt/*
!.tnt/rules/
!.tnt/checks/
!.tnt/agents/
!.tnt/prompts/
!.tnt/superpowers/
.tnt/rules/*
.tnt/checks/*
.tnt/agents/*
.tnt/prompts/*
!.tnt/rules/.keep
!.tnt/checks/.keep
!.tnt/agents/.keep
!.tnt/prompts/.keep
