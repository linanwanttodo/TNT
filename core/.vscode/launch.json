  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "name": "core-vitest",
      "request": "launch",
      "args": ["run"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "disableOptimisticBPs": true,
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "windows": {
        "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs"
      }
    }
  ]
}
